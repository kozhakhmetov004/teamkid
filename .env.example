# Copy to .env and fill in. Never commit .env.
# Local values: run `pnpm db:start` (or `pnpm db:status`) and copy the URL and keys it prints.

# Public (safe in the browser)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Private (server only; read through src/lib/server/env.ts)
SUPABASE_SERVICE_ROLE_KEY=
LLM_API_KEY=
LLM_MODEL=
GOOGLE_PLACES_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_FAMILY_PLUS=
RESEND_API_KEY=
CRON_SECRET=

# Added by the backbone
# HMAC secret for the hidden kid auth passwords (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later locks every child out until their passwords are re-synced (re-run the seed / re-save the child).
KID_AUTH_SECRET=
# anthropic | openai | fake   (empty LLM_API_KEY => deterministic fake output)
LLM_PROVIDER=anthropic
